# 僅為設定範本；複製為 .env 後填入自己的值，不要提交實際憑證
AUTH_TOKEN=
AUTH_MODE=both
# 工具登入預設 7 天，可設定 3600～2592000 秒
SESSION_MAX_AGE=604800
PUBLIC_BASE_URL=
# 留空時產生 config/.session-secret；設定後請固定保存
SESSION_SECRET=
# HTTPS 對外使用時設為 true
SESSION_HTTPS_ONLY=false

# 使用下載工具專用的 OIDC client
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email
OIDC_REDIRECT_URI=
OIDC_DISPLAY_NAME=Synology SSO
OIDC_USE_PKCE=false
OIDC_TOKEN_AUTH_METHOD=client_secret_post
OIDC_ALLOWED_SUBJECTS=
OIDC_ADMIN_SUBJECTS=
APP_TIMEZONE=Asia/Taipei
